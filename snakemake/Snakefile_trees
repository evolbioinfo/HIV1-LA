localrules: all
ruleorder: optimise_branch_lengths > raxml > fasttree

folder = os.path.abspath(config.get("folder", '..'))
data_dir = os.path.join(folder, 'data')
os.makedirs('logs', exist_ok=True)

trees = ['raxml', 'raxed_fast']



rule all:
    input:
        expand(os.path.join(data_dir, 'trees', '{tree}.nwk'), tree=trees),


rule unxzip:
    '''
    Unxzips the alignment.
    '''
    input:
        fa = os.path.join(data_dir, 'aln', '{aln}.fa.xz')
    output:
        fa = temp(os.path.join(data_dir, 'aln', '{aln}.fa'))
    params:
        mem = 120000,
        name = 'unxz_ref',
        qos = 'fast',
        partition = 'common,dedicated,bioevo'
    threads: 1
    shell:
        """
        xz -dc {input.fa} > {output.fa}
        """

rule raxml:
    '''
    Reconstructs a tree with RAxML.
    '''
    input:
        aln = os.path.join(data_dir, 'aln', 'aln.FLT.filtered.fa')
    output:
        tree = os.path.join(data_dir, 'trees', 'raxml.nwk'),
        log = os.path.join(data_dir, 'trees', 'raxml.log'),
    threads: 12
    singularity: "docker://evolbioinfo/raxml-ng:v1.1.0"
    params:
        mem = 40000,
        name = 'raxml',
        qos = 'normal'
    shell:
        """
        raxml-ng --model GTR+G4+FO+IO --msa {input.aln} \
        --seed 239 --threads {threads} --force --tree pars{{1}}
        cp {input.aln}.raxml.bestTree {output.tree}
        cp {input.aln}.raxml.log {output.log}
        rm -rf {input.aln}.raxml.*
        """


rule fasttree:
    '''
    Reconstructs a tree with FastTree.
    '''
    input:
        aln = os.path.join(data_dir, 'aln', 'aln.FLT.filtered.fa')
    output:
        tree = os.path.join(data_dir, 'trees', 'fast.nwk'),
        log = os.path.join(data_dir, 'trees', 'fast.log'),
    threads: 1
    singularity: "docker://evolbioinfo/fasttree:v2.1.11"
    params:
        mem = 10000,
        name='fast',
        qos = 'normal'
    shell: "FastTree -gamma -nt -gtr -cat 4 -log {output.log} < {input.aln} > {output.tree}"


rule resolve:
    '''
    Resolve multifurcations.
    '''
    input:
        tree = os.path.join(data_dir, 'trees', '{tree}.nwk'),
    output:
        tree = os.path.join(data_dir, 'trees', '{tree}.resolved.nwk'),
    singularity:
        "docker://evolbioinfo/gotree:v0.3.0b"
    params:
        mem = 2000,
        name = 'resolve_{tree}',
        qos = 'fast'
    threads: 1
    shell:
        """
        gotree resolve -o {output.tree} -i {input.tree}
        """


rule optimise_branch_lengths:
    '''
    Optimises branch lengths on a given tree with RAxML-NG
    '''
    input:
        aln = os.path.join(data_dir, 'aln', 'aln.FLT.filtered.fa'),
        tree = os.path.join(data_dir, 'trees', '{tree}.resolved.nwk'),
    output:
        tree = os.path.join(data_dir, 'trees', 'raxed_{tree}.nwk'),
        log = os.path.join(data_dir, 'trees', 'raxed_{tree}.log'),
    threads: 4
    singularity: "docker://evolbioinfo/raxml-ng:v1.1.0"
    params:
        mem = 40000,
        name = 'raxbr_{tree}',
    shell:
        """
        cp {input.aln} {input.aln}.{wildcards.tree}
        raxml-ng --evaluate --model GTR+G4+FO+IO --msa {input.aln}.{wildcards.tree} --msa-format FASTA --data-type DNA \
        --tree {input.tree} --threads {threads} --force --seed 239
        cp {input.aln}.{wildcards.tree}.raxml.bestTree {output.tree}
        cp {input.aln}.{wildcards.tree}.raxml.log {output.log}
        rm -rf {input.aln}.{wildcards.tree}*
        """
