rule aln_against_reference:
    '''
    Aligns the outgroup sequence against the ingroup alignment.
    '''
    input:
        fa = os.path.join(data_dir, 'input', 'N.fasta'),
        ref = os.path.join(data_dir, 'aln', 'aln.FLT.filtered.fa'),
    output:
        aln = temp(os.path.join(data_dir, 'aln', 'aln.FLT.filtered.og.fa'))
    params:
        mem = 1000,
        name = 'aln',
        qos = 'fast'
    threads: 12
    singularity: "docker://evolbioinfo/mafft:v7.313"
    shell:
        """
        mafft --thread {threads} --memsave --retree 1 --maxiterate 0 --add {input.fa} \
        --keeplength {input.ref} > {output.aln}
        """

rule xzip:
    '''
    Xzips the alignments.
    '''
    input:
        aln = os.path.join(data_dir, 'aln', 'aln.FLT.filtered.og.fa'),
    output:
        aln = os.path.join(data_dir, 'aln', 'aln.FLT.filtered.og.fa.xz'),
    params:
        mem = 6000,
        name = 'xz_{aln}',
        qos = 'fast',
    threads: 1
    shell:
        """
        xz -zc {input.aln} > {output.aln}
        """

