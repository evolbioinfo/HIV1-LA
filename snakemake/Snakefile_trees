rule fasttree:
    '''
    Reconstructs a tree with FastTree.
    '''
    input:
        aln = os.path.join(data_dir, 'aln', 'aln.FLT.filtered.fa')
    output:
        tree = os.path.join(data_dir, 'trees', 'fast.nwk'),
        log = os.path.join(data_dir, 'trees', 'fast.log'),
    threads: 1
    singularity: "docker://evolbioinfo/fasttree:v2.1.11"
    params:
        mem = 10000,
        name='fast',
        qos = 'normal'
    shell: "FastTree -gamma -nt -gtr -cat 4 -log {output.log} < {input.aln} > {output.tree}"


rule resolve:
    '''
    Resolve multifurcations.
    '''
    input:
        tree = os.path.join(data_dir, 'trees', '{tree}.nwk'),
    output:
        tree = os.path.join(data_dir, 'trees', '{tree}.resolved.nwk'),
    singularity:
        "docker://evolbioinfo/gotree:v0.3.0b"
    params:
        mem = 2000,
        name = 'resolve_{tree}',
        qos = 'fast'
    threads: 1
    shell:
        """
        gotree resolve -o {output.tree} -i {input.tree}
        """


