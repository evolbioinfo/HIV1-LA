rule insert_og_raxml:
    '''
    Inserts the outgroup with RAxML.
    '''
    input:
        aln = os.path.join(data_dir, 'aln', 'aln.FLT.filtered.og.fa'),
        tree = os.path.join(data_dir, 'trees', '{tree}.nwk'),
        starttree = os.path.join(data_dir, 'trees', '{tree}.nwk'),
        model = os.path.join(data_dir, 'trees', '{tree}.model'),
    output:
        tree = os.path.join(data_dir, 'trees', '{tree}.og.nwk'),
        log = os.path.join(data_dir, 'trees', '{tree}.og.log'),
    threads: 12
    singularity: "docker://evolbioinfo/raxml-ng:v1.1.0"
    params:
        mem = 40000,
        name = 'raxml_og',
        qos = 'normal'
    shell:
        """
        cp {input.aln} {input.aln}.{wildcards.tree}_p       
        raxml-ng --model {input.model} --msa {input.aln}.{wildcards.tree}_p --tree pars{{1}}\
        --seed 239 --threads {threads} --force --tree-constraint {input.tree}
        cp {input.aln}.{wildcards.tree}_p.raxml.bestTree {output.tree}
        cp {input.aln}.{wildcards.tree}_p.raxml.log {output.log}
        rm -rf {input.aln}.{wildcards.tree}_p*
        """

rule root:
    '''
    Roots a tree with an outgroup.
    '''
    input:
        tree = os.path.join(data_dir, 'trees', '{tree}.og.nwk'),
        fa = os.path.join(data_dir, 'input', 'N.fasta'),
    output:
        tree = os.path.join(data_dir, 'trees', 'rooted_{tree}.nwk'),
    singularity:
        "docker://evolbioinfo/gotree:v0.3.0b"
    params:
        mem = 2000,
        name = 'root',
        qos = 'fast'
    threads: 1
    shell:
        """
        grep ">" {input.fa} | sed 's/>//g' > {output.tree}.og 
        gotree support clear -i {input.tree} | gotree reroot outgroup -l {output.tree}.og -o {output.tree} -r
        rm -rf {output.tree}.og 
        """


